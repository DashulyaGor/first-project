# Выбор компилятора C
CC = gcc

# Компиляционные флаги
CFLAGS = -std=c11 -Wall -Werror -Wextra -g

# Целевые файлы (исполняемый)
TARGET = s21_cat

# Исходные файлы (C-файлы)
SOURCES = s21_cat.c cat_flags.c # Здесь мы добавляем все .c файлы, участвующие в сборке

# Объектные файлы (.o файлы)
OBJECTS = $(SOURCES:.c=.o)

# Цель 'all' запускается по умолчанию
all: $(TARGET)

# Создание исполняемого файла
$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $^

# Правила для построения объектных файлов (*.o)
%.o: %.c
	$(CC) $(CFLAGS) -c $<

# Чистка временных файлов
clean:
	rm -f $(OBJECTS) $(TARGET)

# Полностью перестроить проект
rebuild: clean all